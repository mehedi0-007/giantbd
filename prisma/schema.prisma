generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
}

enum Gender {
  MALE
  FEMALE
}

enum PRODUCT_GENDER {
  MALE
  LADY
  KIDS
  JUNIOR
  TWIN_JUNIOR
}

enum UnitOfMeasurement {
  PAIR
  LEFT
  RIGHT
}

enum PackingType {
  POLY_BAG
}

enum InventoryMovementType {
  RECEIVED
  SALE
  TRANSFER
  RETURN
  DAMAGE
  ADJUSTMENT
}

model User {
  id        String  @id @default(cuid())
  name      String
  email     String  @unique
  password  String
  phone     String  @unique
  gender    Gender
  image     String?
  signature String?
  status    Status  @default(ACTIVE)

  refreshHash String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdProducts VariantProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  status Status @default(ACTIVE)

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id   String @id @default(cuid())
  name String @unique

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Category {
  id   String @id @default(cuid())
  name String

  status Status @default(ACTIVE)

  subCategories   SubCategory[]
  masterProducts  MasterProduct[]
  variantProducts VariantProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model SubCategory {
  id   String @id @default(cuid())
  name String

  status Status @default(ACTIVE)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  masterProducts  MasterProduct[]
  variantProducts VariantProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Material {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  status Status @default(ACTIVE)

  masterProducts MasterProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model MasterProduct {
  id   String @id @default(cuid())
  name String
  sku  String @unique

  categoryId    String
  subCategoryId String
  materialId    String

  category    Category    @relation(fields: [categoryId], references: [id])
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id])
  material    Material    @relation(fields: [materialId], references: [id])

  status    Status @default(ACTIVE)
  createdBy String

  variantProducts VariantProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([materialId])
  @@index([status])
}

model Color {
  id          String  @id @default(cuid())
  name        String
  description String?
  status      Status  @default(ACTIVE)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  variantProducts VariantProduct[]
}

model VariantProduct {
  id   String @id @default(cuid())
  name String

  sku     String @unique
  barcode String @unique

  size    String
  colorId String
  color   Color  @relation(fields: [colorId], references: [id])
  gender  PRODUCT_GENDER

  uom UnitOfMeasurement

  itemsPerPacket Int

  picture String?

  packingType PackingType @default(POLY_BAG)
  status      Status      @default(ACTIVE)

  shippableQuantity Int @default(0)

  masterProductId String
  masterProduct   MasterProduct @relation(fields: [masterProductId], references: [id])

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  batchItems BatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([masterProductId])
  @@index([creatorId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
}

model Batch {
  id           String @id @default(cuid())
  batch_id     String
  batch_number String

  productionDate DateTime
  expirationDate DateTime

  batchItems BatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batch_id, productionDate])
  @@index([expirationDate])
}

model Document {
  id   String @id @default(cuid())
  path String
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BatchItem {
  id String @id @default(cuid())

  productId String
  product   VariantProduct @relation(fields: [productId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  rackId String
  rack   Rack   @relation(fields: [rackId], references: [id])

  receivedQty  Int
  availableQty Int

  itemsPerPacket Int

  packetCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryMovements InventoryMovement[]

  @@unique([productId, batchId, rackId])
  @@index([productId])
  @@index([batchId])
  @@index([rackId])
}

model InventoryMovement {
  id String @id @default(cuid())

  inventoryBatchItemId String
  inventoryBatchItem   BatchItem @relation(fields: [inventoryBatchItemId], references: [id])

  type InventoryMovementType

  quantity Int

  referenceId String?
  note        String?

  createdAt DateTime @default(now())

  @@index([inventoryBatchItemId])
  @@index([type])
  @@index([createdAt])
}

model Warehouse {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?

  status Status @default(ACTIVE)

  zones Zone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Zone {
  id          String  @id @default(cuid())
  name        String
  code        String
  description String?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status Status @default(ACTIVE)

  subZones SubZone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([status])
}

model SubZone {
  id          String  @id @default(cuid())
  name        String
  code        String
  description String?

  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  status Status @default(ACTIVE)

  racks Rack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, code])
  @@index([zoneId])
  @@index([status])
}

model Rack {
  id          String  @id @default(cuid())
  name        String
  code        String
  description String?

  subZoneId String
  subZone   SubZone @relation(fields: [subZoneId], references: [id])

  status Status @default(ACTIVE)

  inventoryBatchItems BatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subZoneId, code])
  @@index([subZoneId])
  @@index([status])
}
